# Environment: dev, staging, prod
APP_ENV=dev
LOG_LEVEL=INFO

# FastAPI and Streamlit binding
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Scanning interval and rate limits
SCAN_INTERVAL_MINUTES=10
MAX_MASSIVE_CALLS_PER_MINUTE=5

# PostgreSQL (local default for development)
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/weekly_options
REDIS_URL=redis://localhost:6379/0

# Massive API (options, news, earnings data)
# Get your key from: https://massive.io or replace_with_your_massive_api_key
MASSIVE_API_KEY=your_massive_api_key_here
MASSIVE_BASE_URL=https://api.massive.com

# Moomoo OpenAPI via local OpenD daemon
# Install OpenD from: https://www.moomoo.com/download/OpenAPI
# OpenD runs on localhost:11111 by default
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Google Gemini for analysis
# Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Optional: Telegram alerts for high-confidence recommendations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Email alerts
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Backtesting mode flag
BACKTEST_MODE=false
