# Copy this file to .env and fill in real secrets locally.

# App runtime
APP_ENV=dev
LOG_LEVEL=INFO

# API and dashboard
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Scanner behavior
SCAN_INTERVAL_MINUTES=10
WATCHLIST=SNOW,AAPL,MSFT
BACKTEST_MODE=false

# Database
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/weekly_options

# Market/fundamental providers
MASSIVE_API_KEY=replace_with_massive_api_key
MASSIVE_BASE_URL=https://api.massive.com
ALPHA_VANTAGE_API_KEY=replace_with_alpha_vantage_api_key
FINNHUB_API_KEY=replace_with_finnhub_api_key

# Moomoo OpenD
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Gemini
GEMINI_API_KEY=replace_with_gemini_api_key

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=